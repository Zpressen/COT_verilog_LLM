module TopModule (
  input clk,
  input enable,
  input S,
  input A,
  input B,
  input C,
  output reg Z
);

  logic [7:0] q;

  // 8-bit shift register with synchronous enable
  always_ff @(posedge clk) begin
    if (enable) begin
      q <= {S, q[7:1]}; // Shift left with MSB first
    end
  end

  // Multiplexer to select Z based on ABC
  always_comb begin
    case ({A, B, C})
      3'b000: Z = q[0];
      3'b001: Z = q[1];
      3'b010: Z = q[2];
      3'b011: Z = q[3];
      3'b100: Z = q[4];
      3'b101: Z = q[5];
      3'b110: Z = q[6];
      3'b111: Z = q[7];
      default: Z = 1'b0;
    endcase
  end

endmodule

