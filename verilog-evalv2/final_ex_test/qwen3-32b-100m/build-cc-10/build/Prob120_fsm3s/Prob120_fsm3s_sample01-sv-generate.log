    case (state_reg)
      A: state_next = (in) ? B : A;
      B: state_next = (in) ? B : C;
      C: state_next = (in) ? D : A;
      D: state_next = (in) ? B : C;
      default: state_next = A;
    endcase
  end

  // Output logic
  assign out = (state_reg == D) ? 1'b1 : 1'b0;

endmodule

