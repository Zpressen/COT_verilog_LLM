        else next_state <= 2'b01;
      2'b10: // C
        if (in == 1'b0) next_state <= 2'b00;
        else next_state <= 2'b11;
      2'b11: // D
        if (in == 1'b0) next_state <= 2'b10;
        else next_state <= 2'b01;
