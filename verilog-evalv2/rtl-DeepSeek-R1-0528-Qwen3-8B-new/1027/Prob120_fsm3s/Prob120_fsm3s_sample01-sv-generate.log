module TopModule(
  input clk,
  input reset,
  input in,
  output out
);

  reg [1:0] state, next_state;
  assign out = (state == 2'b11) ? 1'b1 : 1'b0;

  always @(posedge clk) begin
    if (reset)
      state <= 2'b00;
    else
      state <= next_state;
