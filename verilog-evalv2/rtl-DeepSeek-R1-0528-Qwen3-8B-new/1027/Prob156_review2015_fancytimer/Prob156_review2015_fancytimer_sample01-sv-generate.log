**[BEGIN]**
module TopModule(
    input clk,
    input reset,
    input data,
    output [3:0] count,
    output counting,
    output done,
    input ack
);

    // State definitions
    localparam IDLE = 2'b00,
              SEARCH = 2'b01,
              COUNTING = 2'b10,
              DONE = 2'b11;

    // State register
    reg [1:0] state;
    reg [3:0] delay_value;
    reg [3:0] remaining_time;
    reg [3:0] count_reg;
    reg counting_reg;
    reg done_reg;

    // State transitions
    always @(posedge clk or posedge reset) begin
        if (reset) begin
            state <= IDLE;
            delay_value <= 4'b0;
            remaining_time <= 4'b0;
            count_reg <= 4'b0;
            counting_reg <= 1'b0;
            done_reg <= 1'b0;
        end else begin
            case (state)
                IDLE: begin
                    if (data == 4'b1101) begin
                        state <= SEARCH;
                    end
                end
                SEARCH: begin
                    if (remaining_time == 4'b0) begin
                        state <= COUNTING;
                    end
                end
                COUNTING: begin
                    if (remaining_time == 4'b0) begin
                        state <= DONE;
                    end
                end
                DONE: begin
                    if (ack) begin
                        state <= IDLE;
                    end
                end
            endcase
        end
    end

    // Output assignments
    assign count = count_reg;
    assign counting = counting_reg;
    assign done = done_reg;

endmodule
**[DONE]**

