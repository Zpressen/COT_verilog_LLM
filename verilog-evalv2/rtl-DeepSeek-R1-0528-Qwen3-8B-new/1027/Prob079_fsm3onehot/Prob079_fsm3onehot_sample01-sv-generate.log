    case (state)
      4'b0001: out = 1'b0;
      4'b0010: out = 1'b0;
      4'b0100: out = 1'b0;
      4'b1000: out = 1'b1;
      default: out = 1'b0; // Default case for safety
    endcase
  end

endmodule
