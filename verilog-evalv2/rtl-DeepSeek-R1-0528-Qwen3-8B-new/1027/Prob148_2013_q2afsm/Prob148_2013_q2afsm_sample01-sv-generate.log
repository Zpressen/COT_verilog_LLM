**State Transitions:**
- **A (idle)**:  
  - r[0]=1 → B (grant device 0)  
  - r[0]=0, r[1]=1 → C (grant device 1)  
  - r[0]=0, r[1]=0, r[2]=1 → D (grant device 2)  
- **B (grant device 0)**:  
  - r[0]=1 → B (continue grant)  
  - r[0]=0 → A (return to idle)  
- **C (grant device 1)**:  
  - r[1]=1 → C (continue grant)  
  - r[1]=0 → A (return to idle)  
- **D (grant device 2)**:  
  - r[2]=1 → D (continue grant)  
  - r[2]=0 → A (return to idle)  

**Output Assignments:**  
- g[0] = 1 in state B (device 0 granted)  
- g[1] = 1 in state C (device 1 granted)  
- g[2] = 1 in state D (device 2 granted)  

**Implementation Notes:**  
- State encoding: A=2'b00, B=2'b01, C=2'b10, D=2'b11  
- Outputs assigned continuously based on current state  
- Synchronous reset (active-low) on clock edge  
- Transitions handled in always block with priority to device 0  

[BEGIN]
module TopModule(
  input  clk,
  input  resetn,
  input  [2:0] r,
  output [2:0] g
);

  // State encoding
  typedef enum {A=2'b00, B=2'b01, C=2'b10, D=2'b11} state_t;
  state_t state, next_state;

  // State register
  always @(posedge clk or negedge resetn) begin
    if (!resetn) state <= A;
    else state <= next_state;
  end

  // State transitions
  always @(*) begin
    case (state)
      A: begin
        if (r[0]) next_state = B;
        else if (r[1]) next_state = C;
        else if (r[2]) next_state = D;
        else next_state = A;
      end
      B: begin
        if (r[0]) next_state = B;
        else next_state = A;
      end
      C: begin
        if (r[1]) next_state = C;
        else next_state = A;
      end
      D: begin
        if (r[2]) next_state = D;
        else next_state = A;
      end
    endcase
  end

  // Output assignments
  assign g[0] = (state == B) ? 1'b1 : 1'b0;
  assign g[1] = (state == C) ? 1'b1 : 1'b0;
  assign g[2] = (state == D) ? 1'b1 : 1'b0;
endmodule
[DONE]

