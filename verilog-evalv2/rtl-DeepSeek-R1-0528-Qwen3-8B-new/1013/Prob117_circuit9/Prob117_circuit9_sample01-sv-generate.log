  // State register
  logic [2:0] q_reg;

  // Combinational logic for next state
  logic [2:0] q_next;

  assign q_next = (a == 0) ? q_reg + 1 : q_reg;

  // Sequential always block with positive edge detection
  always_ff @(posedge clk) begin
