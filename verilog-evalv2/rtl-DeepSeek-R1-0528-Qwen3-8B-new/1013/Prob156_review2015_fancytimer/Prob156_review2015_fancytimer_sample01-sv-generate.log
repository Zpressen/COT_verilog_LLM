First, define the module.

module TopModule (
  input  clk,
  input  reset,
  input  data,
  output reg [3:0] count,  // remaining time
  output reg counting,     // counting output
  output reg done,         // done output
  input  ack
);

  // State definitions
  typedef enum {SEARCH, READ_DELAY, COUNT_DOWN, DONE} state_t;
  state_t state, next_state;

  // Signals for pattern detection in SEARCH
  reg [3:0] pattern_shift_reg;

  // Signals for reading delay bits in READ_DELAY
  reg [3:0] delay_shift_reg;
  reg [3:0] delay_val;

  // Signals for counting in COUNT_DOWN
  reg [3:0] remaining_time;
  reg [3:0] chunk_counter;
  reg [10:0] cycle_counter;  // Counts from 0 to 999 for 1000-cycle chunks

  // State machine always block
  always @(posedge clk or posedge reset) begin
    if (reset) begin
      state <= SEARCH;
      pattern_shift_reg <= 0;
      delay_shift_reg <= 0;
      delay_val <= 0;
      remaining_time <= 0;
      chunk_counter <= 0;
      cycle_counter <= 0;
      counting <= 0;
      done <= 0;
    end else begin
      case (state)
        SEARCH: begin
          // Shift in data for pattern detection
          pattern_shift_reg <= {pattern_shift_reg[2:0], data};
          if (pattern_shift_reg == 4'b1101) begin
            next_state = READ_DELAY;
          end else begin
            next_state = SEARCH;
          end
        end

        READ_DELAY: begin
          // Shift in data for delay bits
          delay_shift_reg <= {delay_shift_reg[2:0], data};
          if (delay_shift_reg == 4'b1111) begin  // 4 bits read
            delay_val <= delay_shift_reg;
            next_state = COUNT_DOWN;
          end else begin
            next_state = READ_DELAY;
          end
        end

        COUNT_DOWN: begin
          // Start counting
          counting <= 1;
          // Increment cycle counter
          cycle_counter <= cycle_counter + 1;
          if (cycle_counter == 999) begin
            cycle_counter <= 0;
            chunk_counter <= chunk_counter + 1;
            if (chunk_counter == remaining_time) begin
              remaining_time <= remaining_time - 1;
              chunk_counter <= 0;
              if (remaining_time == 0) begin
                done <= 1;
                next_state = DONE;
              end else begin
                next_state = COUNT_DOWN;
              end
            end else begin
              next_state = COUNT_DOWN;
            end
          end else begin
            next_state = COUNT_DOWN;
          end
        end

        DONE: begin
          counting <= 0;
          if (ack) begin
            next_state = SEARCH;
          end else begin
            next_state = DONE;
          end
        end

        default: next_state = SEARCH;
      endcase
      state <= next_state;
    end
  end

  // Output count as remaining_time
  assign count = remaining_time;

endmodule

